# 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 커밋되지 않음).
#   cp .env.example .env
#
# Expo는 EXPO_PUBLIC_ 접두어 변수만 앱 번들에 노출합니다.
# ⚠️ 클라이언트에 그대로 박히므로 '비밀'(키·비번)은 절대 넣지 마세요. API 주소는 공개돼도 무방.
EXPO_PUBLIC_API_URL=https://YOUR_BACKEND_HOST

# ── 소셜 로그인 ───────────────────────────────────────────────────────
# 콘솔 등록 절차와 발급값은 SOCIAL-LOGIN-CONSOLE.md 참고.
# EXPO_PUBLIC_ 접두어는 앱 번들에 그대로 실린다 — 서버 시크릿(구글 client secret,
# 애플 .p8)은 절대 여기 넣지 말 것. 백엔드에만 둔다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
# 네이버 콘솔의 iOS URL Scheme. app.json의 scheme과 같아야 앱으로 돌아온다
EXPO_PUBLIC_NAVER_URL_SCHEME=freepets
# 네이버 client secret은 여기 두지 않는다 — 웹은 공식 JS SDK를 쓰므로 필요가 없다.
# 네이버 네이티브 SDK는 초기화에 secret을 요구하는데, 그건 앱에 실릴 수밖에 없는 값이라
# 위에서 말한 "서버 시크릿"(구글 client secret, 애플 .p8)과는 성격이 다르다. 2단계에서
# 네이티브를 붙일 때 이 파일이 아니라 로컬 .env에만 넣는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── 푸시 알림(FCM) ────────────────────────────────────────────────
# 환경변수는 없지만 파일이 하나 필요합니다.
#   `GoogleService-Info.plist`를 프로젝트 루트(app.json 옆)에 두세요.
#   Firebase 콘솔 > 프로젝트 설정 > 내 앱 > iOS(com.freepets.app) > 다운로드
# 없으면 푸시만 빠진 채로 정상 빌드됩니다.
#
# ⚠️ EAS 클라우드 빌드는 gitignore된 파일을 올리지 않습니다. 빌드에 넣으려면 파일 타입
#    환경변수로 한 번 등록해야 합니다(등록은 프로필당 한 번):
#      eas env:create --name GOOGLE_SERVICES_INFO_PLIST --type file \
#        --value ./GoogleService-Info.plist --visibility sensitive --environment production
#    등록 안 하면 빌드는 성공하는데 푸시만 조용히 빠집니다.
